# ========================
# CatchGBT Backend – .env
# ========================

# Supabase (DB + Auth + Storage)
SUPABASE_URL=https://yejiqenqdzupauddjcyi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# JWT (zum Validieren von Supabase Auth Tokens)
JWT_SECRET=your_supabase_jwt_secret_here

# Anthropic Claude API (ersetzt InvokeLLM)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# OpenRouteService (Fahrtzeit)
OPEN_ROUTE_SERVICE_API_KEY=your_ors_key_here

# Google Play Integrity (Service Account JSON als String)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Demo-Modus Passwort
DEMO_PASSWORD=your_demo_password_here

# App URL (für Stripe Redirect)
APP_URL=https://catchgbt.com

# Port
PORT=3000
