# Supabase-Konfiguration (ERFORDERLICH für Datenbank)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq-KI-API (ERFORDERLICH für KI-Funktionen)
GROQ_API_KEY=your-groq-api-key

# Optional: ElevenLabs TTS (für Sprachausgabe)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# Admin-Zugriff (kommagetrennte E-Mail-Allowlist, z.B. fuer /api/maps/*)
ADMIN_EMAILS=admin@baitbuddy.app

# Optional: Kaufverifikation fuer /premium/activate (ohne diese Werte
# bleibt Premium-Aktivierung mit 501 gesperrt statt ungeprueft freizuschalten).
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON wird benoetigt, um Kaeufe aus der Play-App
# zu verifizieren (die Web-App hat keinen Checkout — Kaeufe laufen nur ueber
# Google Play Billing in der nativen Android-App).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}

# Server-Port
PORT=3000

# Umgebung
NODE_ENV=development

# Email-Konfiguration (für Support-Tickets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SUPPORT_EMAIL=kaisaschnitt99@gmail.com
