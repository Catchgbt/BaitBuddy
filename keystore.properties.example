# Android Keystore Konfiguration für BaitBuddy
#
# Kopiere diese Datei zu: android/keystore.properties
# und fülle die Werte mit deinen Keystore-Daten aus
#
# WICHTIG: keystore.properties ist in .gitignore und wird NICHT gepusht!
# Halte diese Datei privat und sicher!

# Pfad zur Keystore-Datei (relativ zu android/ oder absolut)
storeFile=path/to/baitbuddy.jks

# Passwort für den Keystore
storePassword=your_keystore_password

# Name des Keys/Alias im Keystore (meist: "baitbuddy" oder "release")
keyAlias=baitbuddy

# Passwort für den speziellen Key
keyPassword=your_key_password
