# Frontend-Konfiguration für BaitBuddy

# Supabase API (ERFORDERLICH)
# Siehe: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-key

# Public App-URL (ERFORDERLICH für Referral-Links, OAuth-Callbacks)
# Diese URL muss öffentlich erreichbar und mit Supabase konfiguriert sein
VITE_PUBLIC_URL=https://app.baitbuddy.example

# Optional: Sentry Error Tracking (für Fehlererfassung in Production)
# VITE_SENTRY_DSN=https://your-key@sentry.io/project-id

# Optional: Umgebung (development/production — wird automatisch erkannt)
# VITE_ENV=production
